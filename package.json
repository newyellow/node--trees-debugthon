{
  "name": "trees-debugthon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "python3 build-assets.py && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "data:refresh": "node scripts/prepare-data.mjs && node scripts/prepare-regions.mjs",
    "boundaries:refresh": "node scripts/prepare-regions.mjs",
    "imagery:plan": "node scripts/offline-imagery.mjs plan",
    "imagery:import": "node scripts/offline-imagery.mjs import",
    "imagery:download": "node scripts/offline-imagery.mjs download",
    "test": "node --test",
    "start": "node server/plant-advice-server.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "polygon-clipping": "^0.15.7",
    "proj4": "^2.19.10",
    "rbush": "^4.0.1",
    "serve-handler": "6.1.7",
    "shapefile": "^0.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "vite": "^7.1.12"
  }
}
